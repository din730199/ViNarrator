{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViNarrator",
  "version": "0.1.0",
  "identifier": "com.vinarrator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "yarn vite:dev",
    "beforeBuildCommand": "yarn vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "create": false,
        "title": "ViNarrator — Thuyết minh game",
        "width": 460,
        "height": 660,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "create": false,
        "title": "ViNarrator — Chọn vùng",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
