{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViNarrator",
  "version": "0.1.5",
  "identifier": "com.vinarrator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "yarn vite:dev",
    "beforeBuildCommand": "yarn vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "create": false,
        "title": "ViNarrator — Thuyết minh game",
        "width": 460,
        "height": 720,
        "minWidth": 400,
        "minHeight": 620,
        "resizable": true
      },
      {
        "label": "captions",
        "url": "captions.html",
        "create": false,
        "title": "ViNarrator — Phụ đề",
        "width": 760,
        "height": 300,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/din730199/ViNarrator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MTdBRTQxNzA3QkNCRQpSV1MrdkFjWDVIcUJEMUhPVTk2Smx3KzlDeTBDeUxVUUVyQWVWSG1lWDI5UE5zUi81T0FZS2x6WAo="
    }
  }
}
