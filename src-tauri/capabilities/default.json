{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "captions"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "global-shortcut:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-start-dragging"
  ]
}
